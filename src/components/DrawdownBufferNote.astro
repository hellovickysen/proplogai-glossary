<figure class="note" data-note-root>
  <button type="button" class="note-trigger" aria-label="Open the daily drawdown learning note at a larger size" data-note-trigger>
    <img src="/glossary/images/daily-drawdown-buffer-note.webp" alt="Handwritten daily drawdown note showing a 50,000 dollar start, 47,500 dollar daily floor, 48,300 dollar current equity, and 800 dollar buffer" loading="lazy" decoding="async" />
    <span aria-hidden="true">Click to zoom</span>
  </button>
  <figcaption>Check the official floor, the account value the rule measures, and the reset before you use the buffer.</figcaption>
  <dialog class="note-dialog" data-note-dialog aria-label="Larger daily drawdown learning note">
    <div>
      <button type="button" class="note-close" data-note-close>Close</button>
      <img src="/glossary/images/daily-drawdown-buffer-note.webp" alt="Handwritten daily drawdown note showing a 50,000 dollar start, 47,500 dollar daily floor, 48,300 dollar current equity, and 800 dollar buffer" />
    </div>
  </dialog>
</figure>

<script>
  document.querySelectorAll('[data-note-root]').forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    const trigger = root.querySelector('[data-note-trigger]');
    const dialog = root.querySelector('[data-note-dialog]');
    const close = root.querySelector('[data-note-close]');
    if (!(trigger instanceof HTMLButtonElement) || !(dialog instanceof HTMLDialogElement)) return;
    trigger.addEventListener('click', () => dialog.showModal());
    close?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  });
</script>

<style>
  .note { margin: 0 0 1.75rem; }
  .note-trigger { position: relative; display: block; width: 100%; overflow: hidden; border: 1px solid rgba(255,255,255,.1); border-radius: 1rem; background: rgba(255,255,255,.03); padding: 0; cursor: zoom-in; }
  .note-trigger img { display: block; width: 100%; height: auto; }
  .note-trigger span { position: absolute; right: .65rem; bottom: .65rem; border: 1px solid rgba(255,255,255,.2); border-radius: 999px; background: rgba(7,9,18,.84); padding: .35rem .6rem; color: rgba(255,255,255,.82); font-size: .68rem; }
  figcaption { margin-top: .6rem; color: rgba(255,255,255,.45); font-size: .78rem; line-height: 1.5; }
  .note-dialog { width: min(96vw,1200px); max-width: none; max-height: 94vh; border: 0; background: transparent; padding: 0; overflow: visible; }
  .note-dialog::backdrop { background: rgba(2,3,8,.9); backdrop-filter: blur(6px); }
  .note-dialog > div { position: relative; display: grid; place-items: center; max-height: 94vh; }
  .note-dialog img { display: block; max-width: 96vw; max-height: 90vh; border-radius: .8rem; object-fit: contain; }
  .note-close { position: absolute; z-index: 1; top: .6rem; right: .6rem; border: 1px solid rgba(255,255,255,.22); border-radius: 999px; background: rgba(7,9,18,.9); padding: .45rem .7rem; color: white; cursor: pointer; }
</style>

<figure class="drawdown-note" data-drawdown-note-root>
  <button type="button" class="drawdown-note-trigger" aria-label="Open the drawdown learning note at a larger size" data-drawdown-note-trigger>
    <img src="/glossary/images/drawdown-performance-vs-rule-note.webp" alt="Handwritten XAUUSD example showing an account falling from a 108,000 dollar peak to 104,000 dollars, creating a 4,000 dollar or 3.7 percent drawdown, while explaining that a prop firm floor is a separate rule" loading="lazy" decoding="async" />
    <span aria-hidden="true">Click to zoom</span>
  </button>
  <figcaption>This measures the account decline. Your firm's daily or overall floor is a separate rule.</figcaption>
  <dialog class="drawdown-note-dialog" data-drawdown-note-dialog aria-label="Larger drawdown learning note">
    <div>
      <button type="button" class="drawdown-note-close" data-drawdown-note-close>Close</button>
      <img src="/glossary/images/drawdown-performance-vs-rule-note.webp" alt="Handwritten XAUUSD example showing an account falling from a 108,000 dollar peak to 104,000 dollars, creating a 4,000 dollar or 3.7 percent drawdown, while explaining that a prop firm floor is a separate rule" />
    </div>
  </dialog>
</figure>

<script>
  document.querySelectorAll('[data-drawdown-note-root]').forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    const trigger = root.querySelector('[data-drawdown-note-trigger]');
    const dialog = root.querySelector('[data-drawdown-note-dialog]');
    const close = root.querySelector('[data-drawdown-note-close]');
    if (!(trigger instanceof HTMLButtonElement) || !(dialog instanceof HTMLDialogElement)) return;
    trigger.addEventListener('click', () => dialog.showModal());
    close?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  });
</script>

<style>
  .drawdown-note { margin: 0 0 1.75rem; }
  .drawdown-note-trigger { position: relative; display: block; width: 100%; overflow: hidden; border: 1px solid rgba(255,255,255,.1); border-radius: 1rem; background: rgba(255,255,255,.03); padding: 0; cursor: zoom-in; }
  .drawdown-note-trigger img { display: block; width: 100%; height: auto; }
  .drawdown-note-trigger span { position: absolute; right: .65rem; bottom: .65rem; border: 1px solid rgba(255,255,255,.2); border-radius: 999px; background: rgba(7,9,18,.84); padding: .35rem .6rem; color: rgba(255,255,255,.82); font-size: .68rem; }
  figcaption { margin-top: .6rem; color: rgba(255,255,255,.45); font-size: .78rem; line-height: 1.5; }
  .drawdown-note-dialog { width: min(96vw,1200px); max-width: none; max-height: 94vh; border: 0; background: transparent; padding: 0; overflow: visible; }
  .drawdown-note-dialog::backdrop { background: rgba(2,3,8,.9); backdrop-filter: blur(6px); }
  .drawdown-note-dialog > div { position: relative; display: grid; place-items: center; max-height: 94vh; }
  .drawdown-note-dialog img { display: block; max-width: 96vw; max-height: 90vh; border-radius: .8rem; object-fit: contain; }
  .drawdown-note-close { position: absolute; z-index: 1; top: .6rem; right: .6rem; border: 1px solid rgba(255,255,255,.22); border-radius: 999px; background: rgba(7,9,18,.9); padding: .45rem .7rem; color: white; cursor: pointer; }
</style>

---
const steps = [
  {
    number: '01',
    label: 'Context',
    title: 'Name the trade precisely',
    description: 'Stable labels make similar records easier to compare later.',
    primary: 'XAUUSD · London session',
    secondary: 'Setup: Breakout above the Asian high',
  },
  {
    number: '02',
    label: 'Plan',
    title: 'Write the conditions before the result',
    description: 'Preserve the confirmation and invalidation conditions before hindsight changes the story.',
    primary: 'Wait for the break and candle close',
    secondary: 'Use the stop and size written before entry',
  },
  {
    number: '03',
    label: 'Action',
    title: 'Record what you actually did',
    description: 'Write the execution as it happened, including any unplanned change.',
    primary: 'Entered after the candle closed',
    secondary: 'Planned stop · No unplanned change',
  },
  {
    number: '04',
    label: 'Result',
    title: 'Keep outcome and process separate',
    description: 'The result is one field. It does not rewrite whether the action matched the plan.',
    primary: 'Result: +$85 after stated costs',
    secondary: 'Calm · Plan followed: Yes · Screenshot saved',
  },
];
---

<section class="journal-loop" data-journal-loop aria-labelledby="journal-loop-title">
  <div class="loop-heading">
    <div>
      <p class="eyebrow">Interactive example · fictional trade</p>
      <h2 id="journal-loop-title">One trade, four useful records</h2>
    </div>
    <span class="instrument">XAUUSD</span>
  </div>

  <div class="step-grid" role="group" aria-label="Trading journal stages">
    {steps.map((step, index) => (
      <button
        type="button"
        class:list={['step-button', { active: index === 0 }]}
        aria-pressed={index === 0 ? 'true' : 'false'}
        data-number={step.number}
        data-label={step.label}
        data-title={step.title}
        data-description={step.description}
        data-primary={step.primary}
        data-secondary={step.secondary}
      >
        <span class="step-number">{step.number}</span>
        <span class="step-label">{step.label}</span>
      </button>
    ))}
  </div>

  <div class="example-panel" aria-live="polite">
    <div class="panel-copy">
      <p class="panel-kicker" data-panel-kicker>01 · Context</p>
      <h3 data-panel-title>{steps[0].title}</h3>
      <p data-panel-description>{steps[0].description}</p>
    </div>
    <div class="record-card">
      <span class="record-dot" aria-hidden="true"></span>
      <div>
        <p data-panel-primary>{steps[0].primary}</p>
        <span data-panel-secondary>{steps[0].secondary}</span>
      </div>
    </div>
  </div>

  <noscript>
    <p class="noscript-note">The four records are context, plan, action and result. Keep the trade outcome separate from whether the action matched the plan.</p>
  </noscript>
</section>

<script>
  document.querySelectorAll('[data-journal-loop]').forEach((root) => {
    const buttons = [...root.querySelectorAll('[data-number]')];
    const kicker = root.querySelector('[data-panel-kicker]');
    const title = root.querySelector('[data-panel-title]');
    const description = root.querySelector('[data-panel-description]');
    const primary = root.querySelector('[data-panel-primary]');
    const secondary = root.querySelector('[data-panel-secondary]');

    for (const button of buttons) {
      button.addEventListener('click', () => {
        for (const candidate of buttons) {
          const isActive = candidate === button;
          candidate.classList.toggle('active', isActive);
          candidate.setAttribute('aria-pressed', String(isActive));
        }

        kicker.textContent = `${button.dataset.number} · ${button.dataset.label}`;
        title.textContent = button.dataset.title;
        description.textContent = button.dataset.description;
        primary.textContent = button.dataset.primary;
        secondary.textContent = button.dataset.secondary;
      });
    }
  });
</script>

<style>
  .journal-loop { margin:0 0 2rem; overflow:hidden; border:1px solid rgba(96,165,250,.18); border-radius:1.25rem; background:radial-gradient(circle at 88% 8%,rgba(34,211,238,.11),transparent 34%),radial-gradient(circle at 8% 100%,rgba(139,92,246,.12),transparent 38%),rgba(255,255,255,.025); padding:1.25rem; }
  .loop-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; }
  .eyebrow,.panel-kicker { margin:0; font-family:'JetBrains Mono',monospace; font-size:.625rem; letter-spacing:.14em; text-transform:uppercase; color:rgba(103,232,249,.62); }
  h2 { margin:.35rem 0 0; font-family:'Space Grotesk',sans-serif; font-size:1.2rem; line-height:1.3; color:rgba(255,255,255,.92); }
  .instrument { flex:none; border:1px solid rgba(250,204,21,.22); border-radius:999px; background:rgba(250,204,21,.07); padding:.35rem .55rem; font-family:'JetBrains Mono',monospace; font-size:.625rem; letter-spacing:.08em; color:rgba(253,224,71,.8); }
  .step-grid { position:relative; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.45rem; margin-top:1.25rem; }
  .step-grid::before { position:absolute; top:1.05rem; right:8%; left:8%; height:1px; background:linear-gradient(90deg,rgba(139,92,246,.35),rgba(34,211,238,.35)); content:''; }
  .step-button { position:relative; z-index:1; display:flex; min-width:0; flex-direction:column; align-items:center; gap:.45rem; border:0; background:transparent; color:rgba(255,255,255,.42); cursor:pointer; }
  .step-number { display:grid; width:2.1rem; height:2.1rem; place-items:center; border:1px solid rgba(255,255,255,.1); border-radius:.65rem; background:#0b0b12; font-family:'JetBrains Mono',monospace; font-size:.625rem; transition:180ms ease; }
  .step-label { font-size:.7rem; font-weight:600; }
  .step-button:hover,.step-button:focus-visible,.step-button.active { color:rgba(255,255,255,.9); outline:none; }
  .step-button:hover .step-number,.step-button:focus-visible .step-number,.step-button.active .step-number { border-color:rgba(34,211,238,.42); background:linear-gradient(135deg,rgba(139,92,246,.22),rgba(34,211,238,.18)); box-shadow:0 0 20px rgba(34,211,238,.08); }
  .example-panel { display:grid; grid-template-columns:minmax(0,1fr) minmax(190px,.8fr); gap:1rem; align-items:center; margin-top:1.15rem; border:1px solid rgba(255,255,255,.07); border-radius:.9rem; background:rgba(5,7,13,.62); padding:1rem; }
  .panel-copy h3 { margin:.25rem 0 0; font-family:'Space Grotesk',sans-serif; font-size:.95rem; color:rgba(255,255,255,.9); }
  .panel-copy>p:last-child { margin:.4rem 0 0; font-size:.75rem; line-height:1.55; color:rgba(255,255,255,.43); }
  .record-card { display:flex; gap:.65rem; align-items:flex-start; border-left:1px solid rgba(34,211,238,.18); padding-left:1rem; }
  .record-dot { width:.45rem; height:.45rem; flex:none; margin-top:.3rem; border-radius:999px; background:#22d3ee; box-shadow:0 0 12px rgba(34,211,238,.55); }
  .record-card p { margin:0; font-size:.78rem; font-weight:600; color:rgba(255,255,255,.86); }
  .record-card span:last-child { display:block; margin-top:.3rem; font-size:.68rem; line-height:1.45; color:rgba(255,255,255,.38); }
  .noscript-note { margin:1rem 0 0; font-size:.72rem; color:rgba(255,255,255,.42); }
  @media(max-width:640px){ .journal-loop{padding:1rem}.loop-heading{align-items:center}.step-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem}.step-grid::before{display:none}.step-button{flex-direction:row;justify-content:flex-start;border:1px solid rgba(255,255,255,.07);border-radius:.75rem;padding:.55rem;background:rgba(255,255,255,.018)}.step-button.active{border-color:rgba(34,211,238,.25);background:rgba(34,211,238,.06)}.step-number{width:1.75rem;height:1.75rem}.example-panel{grid-template-columns:1fr}.record-card{border-top:1px solid rgba(34,211,238,.18);border-left:0;padding-top:.8rem;padding-left:0} }
  @media(prefers-reduced-motion:reduce){.step-number{transition:none}}
</style>

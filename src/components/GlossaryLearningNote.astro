---
const { src, alt, caption, label = 'Open the learning note at a larger size' } = Astro.props;
---

<figure class="learning-note" data-learning-note-root>
  <button type="button" class="learning-note-trigger" aria-label={label} data-learning-note-trigger>
    <img src={src} alt={alt} loading="lazy" decoding="async" />
    <span aria-hidden="true">Click to zoom</span>
  </button>
  <figcaption>{caption}</figcaption>
  <dialog class="learning-note-dialog" data-learning-note-dialog aria-label={label}>
    <div>
      <button type="button" class="learning-note-close" data-learning-note-close>Close</button>
      <img src={src} alt={alt} />
    </div>
  </dialog>
</figure>

<script>
  document.querySelectorAll('[data-learning-note-root]').forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    const trigger = root.querySelector('[data-learning-note-trigger]');
    const dialog = root.querySelector('[data-learning-note-dialog]');
    const close = root.querySelector('[data-learning-note-close]');
    if (!(trigger instanceof HTMLButtonElement) || !(dialog instanceof HTMLDialogElement)) return;
    trigger.addEventListener('click', () => dialog.showModal());
    close?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  });
</script>

<style>
  .learning-note { margin: 0 0 1.75rem; }
  .learning-note-trigger { position: relative; display: block; width: 100%; overflow: hidden; border: 1px solid rgba(255,255,255,.1); border-radius: 1rem; background: rgba(255,255,255,.03); padding: 0; cursor: zoom-in; }
  .learning-note-trigger:focus-visible { outline: 2px solid #22d3ee; outline-offset: 3px; }
  .learning-note-trigger img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; }
  .learning-note-trigger span { position: absolute; right: .65rem; bottom: .65rem; border: 1px solid rgba(255,255,255,.2); border-radius: 999px; background: rgba(7,9,18,.84); padding: .35rem .6rem; color: rgba(255,255,255,.82); font-size: .68rem; }
  figcaption { margin-top: .6rem; color: rgba(255,255,255,.45); font-size: .78rem; line-height: 1.5; }
  .learning-note-dialog { width: min(96vw,1200px); max-width: none; max-height: 94vh; border: 0; background: transparent; padding: 0; overflow: visible; }
  .learning-note-dialog::backdrop { background: rgba(2,3,8,.9); backdrop-filter: blur(6px); }
  .learning-note-dialog > div { position: relative; display: grid; place-items: center; max-height: 94vh; padding-top: 3rem; }
  .learning-note-dialog img { display: block; max-width: 94vw; max-height: calc(90vh - 3rem); border-radius: .8rem; object-fit: contain; }
  .learning-note-close { position: absolute; z-index: 1; top: .2rem; right: .2rem; border: 1px solid rgba(255,255,255,.22); border-radius: 999px; background: rgba(7,9,18,.9); padding: .45rem .7rem; color: white; cursor: pointer; }
  .learning-note-close:focus-visible { outline: 2px solid #22d3ee; outline-offset: 2px; }
</style>

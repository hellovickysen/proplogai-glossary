<figure class="revenge-note" data-revenge-note-root>
  <button type="button" class="revenge-note-trigger" aria-label="Open the revenge trading decision note at a larger size" data-revenge-note-trigger>
    <img src="/glossary/images/revenge-trading-full-check.webp" alt="Handwritten sequence showing plan, loss, urge, checking the same rules, and choosing between a new setup that passes or stopping" loading="lazy" decoding="async" />
    <span aria-hidden="true">Click to zoom</span>
  </button>
  <figcaption>A trade after a loss is not automatically revenge. Check whether the decision still follows the same rules.</figcaption>
  <dialog class="revenge-note-dialog" data-revenge-note-dialog aria-label="Larger revenge trading decision note">
    <div>
      <button type="button" class="revenge-note-close" data-revenge-note-close>Close</button>
      <img src="/glossary/images/revenge-trading-full-check.webp" alt="Handwritten sequence showing plan, loss, urge, checking the same rules, and choosing between a new setup that passes or stopping" />
    </div>
  </dialog>
</figure>

<script>
  document.querySelectorAll('[data-revenge-note-root]').forEach((root) => {
    if (!(root instanceof HTMLElement) || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';
    const trigger = root.querySelector('[data-revenge-note-trigger]');
    const dialog = root.querySelector('[data-revenge-note-dialog]');
    const close = root.querySelector('[data-revenge-note-close]');
    if (!(trigger instanceof HTMLButtonElement) || !(dialog instanceof HTMLDialogElement)) return;
    trigger.addEventListener('click', () => dialog.showModal());
    close?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  });
</script>

<style>
  .revenge-note { margin: 0 0 1.75rem; }
  .revenge-note-trigger { position: relative; display: block; width: 100%; overflow: hidden; border: 1px solid rgba(255,255,255,.1); border-radius: 1rem; background: rgba(255,255,255,.03); padding: 0; cursor: zoom-in; }
  .revenge-note-trigger:focus-visible { outline: 2px solid #22d3ee; outline-offset: 3px; }
  .revenge-note-trigger img { display: block; width: 100%; height: auto; }
  .revenge-note-trigger span { position: absolute; right: .65rem; bottom: .65rem; border: 1px solid rgba(255,255,255,.2); border-radius: 999px; background: rgba(7,9,18,.84); padding: .35rem .6rem; color: rgba(255,255,255,.82); font-size: .68rem; }
  figcaption { margin-top: .6rem; color: rgba(255,255,255,.45); font-size: .78rem; line-height: 1.5; }
  .revenge-note-dialog { width: min(96vw,1200px); max-width: none; max-height: 94vh; border: 0; background: transparent; padding: 0; overflow: visible; }
  .revenge-note-dialog::backdrop { background: rgba(2,3,8,.9); backdrop-filter: blur(6px); }
  .revenge-note-dialog > div { position: relative; display: grid; place-items: center; max-height: 94vh; }
  .revenge-note-dialog img { display: block; max-width: 96vw; max-height: 90vh; border-radius: .8rem; object-fit: contain; }
  .revenge-note-close { position: absolute; z-index: 1; top: .6rem; right: .6rem; border: 1px solid rgba(255,255,255,.22); border-radius: 999px; background: rgba(7,9,18,.9); padding: .45rem .7rem; color: white; cursor: pointer; }
  .revenge-note-close:focus-visible { outline: 2px solid #22d3ee; outline-offset: 2px; }
</style>
